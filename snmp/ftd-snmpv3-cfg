#!/usr/bin/env bash
# Configure SNMPv3 polling on an FDM-managed Cisco FTD.
#
# Lab topology used here:
#   FTD/FDM management address: 10.1.0.3
#   SNMP managers:              10.0.0.198, 10.0.0.85
#   FTD polling interface:      management
#
# Requirements: curl and jq. Install snmpwalk to run the final test.
# Run with:
#   bash ~/cml_labs/ftd_snmpv3.cfg
# Or supply the FDM password non-interactively:
#   FDM_PASSWORD='<password>' bash ~/cml_labs/ftd_snmpv3.cfg
#
# The script uses -k because the CML FTD has a self-signed certificate whose
# hostname does not match 10.1.0.3. Use a trusted certificate in production.

set -euo pipefail

# -----------------------------------------------------------------------------
# Lab settings
# -----------------------------------------------------------------------------
FDM_URL="https://10.1.0.3"
API_VERSION="v6"
FDM_USERNAME="admin"

# Add or remove addresses as needed. Each address is the source IP of an SNMP
# manager that is allowed to poll the FTD. The script creates/reuses one FDM
# network object and one SNMP host association for each address.
SNMP_MANAGER_IPS=(
    "10.0.0.198"
    "10.0.0.85"
)
SNMP_MANAGER_NAME_PREFIX="snmp-manager"
SNMP_HOST_NAME_PREFIX="snmpv3-manager"
SNMP_INTERFACE_NAME="management"

SNMP_USERNAME="admin"
SNMP_AUTH_PASSWORD="cisco123!"
SNMP_PRIV_PASSWORD="cisco123!"
SNMP_AUTH_ALGORITHM="SHA"
SNMP_PRIV_ALGORITHM="AES128"

if (( ${#SNMP_MANAGER_IPS[@]} == 0 )); then
    echo "ERROR: SNMP_MANAGER_IPS must contain at least one manager address." >&2
    exit 1
fi

command -v curl >/dev/null || { echo "ERROR: curl is required" >&2; exit 1; }
command -v jq >/dev/null || { echo "ERROR: jq is required" >&2; exit 1; }

# -----------------------------------------------------------------------------
# 1. Authenticate to the FDM REST API
# -----------------------------------------------------------------------------
if [[ -z "${FDM_PASSWORD:-}" ]]; then
    read -rsp "FDM password for ${FDM_USERNAME}: " FDM_PASSWORD
    echo
fi

TOKEN_RESPONSE=$(curl -skS --fail-with-body -X POST \
    "${FDM_URL}/api/fdm/latest/fdm/token" \
    -H 'Content-Type: application/json' \
    -H 'Accept: application/json' \
    --data "$(jq -n \
        --arg username "$FDM_USERNAME" \
        --arg password "$FDM_PASSWORD" \
        '{grant_type:"password", username:$username, password:$password}')")

TOKEN=$(jq -er '.access_token' <<<"$TOKEN_RESPONSE")
echo "Authenticated to ${FDM_URL}."

# Wrapper for authenticated API requests. The remaining arguments are passed
# directly to curl, for example: api /object/networks -X POST --data "$JSON"
api() {
    local path=$1
    shift
    curl -skS --fail-with-body \
        "${FDM_URL}/api/fdm/${API_VERSION}${path}" \
        -H "Authorization: Bearer ${TOKEN}" \
        -H 'Content-Type: application/json' \
        -H 'Accept: application/json' \
        "$@"
}

# -----------------------------------------------------------------------------
# 2. Create or reuse a network object for each SNMP manager
#
# These addresses are the source hosts allowed to poll the FTD. They are not
# addresses assigned to the FTD itself. Existing HOST objects are matched by
# their IP value, so the script can reuse objects that have different names.
# -----------------------------------------------------------------------------
NETWORKS=$(api '/object/networks?limit=100')
EXISTING_HOSTS=$(api '/object/snmphosts?limit=100')
declare -A NETWORK_OBJECTS=()

for SNMP_MANAGER_IP in "${SNMP_MANAGER_IPS[@]}"; do
    SAFE_IP=${SNMP_MANAGER_IP//[^a-zA-Z0-9]/-}
    SNMP_MANAGER_NAME="${SNMP_MANAGER_NAME_PREFIX}-${SAFE_IP}"

    # If duplicate network objects contain the same address, prefer the one
    # already referenced by an SNMP host. Otherwise, reuse the first matching
    # HOST object.
    NETWORK_OBJECT=$(jq -c \
        --arg value "$SNMP_MANAGER_IP" \
        --argjson hosts "$EXISTING_HOSTS" \
        '(
            first(
                .items[] as $network
                | select($network.subType == "HOST" and $network.value == $value)
                | select(any($hosts.items[]?; .managerAddress.id == $network.id))
                | $network
            )
            // first(.items[] | select(.subType == "HOST" and .value == $value))
            // empty
        )' <<<"$NETWORKS")

    if [[ -n "$NETWORK_OBJECT" ]]; then
        NETWORK_ID=$(jq -er '.id' <<<"$NETWORK_OBJECT")
        NETWORK_OBJECT=$(api "/object/networks/${NETWORK_ID}")
        echo "Reusing network object $(jq -r '.name' <<<"$NETWORK_OBJECT") -> ${SNMP_MANAGER_IP}."
    else
        NETWORK_PAYLOAD=$(jq -n \
            --arg name "$SNMP_MANAGER_NAME" \
            --arg value "$SNMP_MANAGER_IP" \
            '{
                name: $name,
                description: "SNMP monitoring server",
                subType: "HOST",
                value: $value,
                dnsResolution: "IPV4_ONLY",
                type: "networkobject"
            }')

        NETWORK_OBJECT=$(api '/object/networks' \
            -X POST --data-binary "$NETWORK_PAYLOAD")
        NETWORK_ID=$(jq -er '.id' <<<"$NETWORK_OBJECT")
        NETWORK_OBJECT=$(api "/object/networks/${NETWORK_ID}")
        echo "Created network object ${SNMP_MANAGER_NAME} -> ${SNMP_MANAGER_IP}."
    fi

    NETWORK_OBJECTS["$SNMP_MANAGER_IP"]="$NETWORK_OBJECT"
    jq '{name, value, version, id, type}' <<<"$NETWORK_OBJECT"
    printf '%s\n' "$NETWORK_OBJECT" >"/tmp/snmp-manager-network-${SAFE_IP}.json"
done

# -----------------------------------------------------------------------------
# 3. Create or update the SNMPv3 user
#
# PRIV means authPriv: authenticate with SHA and encrypt with AES128.
# -----------------------------------------------------------------------------
USERS=$(api '/object/snmpusers?limit=100')
SNMP_USER_OBJECT=$(jq -c --arg name "$SNMP_USERNAME" \
    '.items[] | select(.name == $name)' <<<"$USERS")

if [[ -n "$SNMP_USER_OBJECT" ]]; then
    SNMP_USER_ID=$(jq -r '.id' <<<"$SNMP_USER_OBJECT")
    SNMP_USER_VERSION=$(jq -r '.version' <<<"$SNMP_USER_OBJECT")
else
    SNMP_USER_ID=""
    SNMP_USER_VERSION=""
fi

SNMP_USER_PAYLOAD=$(jq -n \
    --arg version "$SNMP_USER_VERSION" \
    --arg name "$SNMP_USERNAME" \
    --arg authAlgorithm "$SNMP_AUTH_ALGORITHM" \
    --arg authPassword "$SNMP_AUTH_PASSWORD" \
    --arg privAlgorithm "$SNMP_PRIV_ALGORITHM" \
    --arg privPassword "$SNMP_PRIV_PASSWORD" \
    --arg id "$SNMP_USER_ID" \
    '{
        version: (if $version == "" then null else $version end),
        name: $name,
        description: "SNMPv3 monitoring user",
        securityLevel: "PRIV",
        authenticationAlgorithm: $authAlgorithm,
        authenticationPassword: $authPassword,
        encryptionAlgorithm: $privAlgorithm,
        encryptionPassword: $privPassword,
        id: (if $id == "" then null else $id end),
        type: "snmpuser"
    }')

if [[ -n "$SNMP_USER_ID" ]]; then
    api "/object/snmpusers/${SNMP_USER_ID}" \
        -X PUT --data-binary "$SNMP_USER_PAYLOAD" >/dev/null
    SNMP_USER_OBJECT=$(api "/object/snmpusers/${SNMP_USER_ID}")
    echo "Updated SNMPv3 user ${SNMP_USERNAME}."
else
    SNMP_USER_OBJECT=$(api '/object/snmpusers' \
        -X POST --data-binary "$SNMP_USER_PAYLOAD")
    SNMP_USER_ID=$(jq -er '.id' <<<"$SNMP_USER_OBJECT")
    SNMP_USER_OBJECT=$(api "/object/snmpusers/${SNMP_USER_ID}")
    echo "Created SNMPv3 user ${SNMP_USERNAME}."
fi

jq '{name, securityLevel, authenticationAlgorithm, encryptionAlgorithm, version, id, type}' \
    <<<"$SNMP_USER_OBJECT"
printf '%s\n' "$SNMP_USER_OBJECT" >/tmp/snmp-user.json

# -----------------------------------------------------------------------------
# 4. Find the FTD interface through which the manager will poll
#
# Use "management" because 10.0.0.198 reaches the FTD at 10.1.0.3. To poll a
# data-interface address instead, change SNMP_INTERFACE_NAME above.
# -----------------------------------------------------------------------------
INTERFACES=$(api '/devices/default/interfaces')

# Print the list for learning and troubleshooting.
jq '.items[] | {
    name,
    hardwareName,
    ipAddress: .ipv4.ipAddress.ipAddress,
    netmask: .ipv4.ipAddress.netmask,
    managementInterface,
    managementOnly,
    version,
    id,
    type
}' <<<"$INTERFACES"

INTERFACE_OBJECT=$(jq -c --arg name "$SNMP_INTERFACE_NAME" \
    '.items[] | select(.name == $name)' <<<"$INTERFACES")

if [[ -z "$INTERFACE_OBJECT" ]]; then
    echo "ERROR: Interface '${SNMP_INTERFACE_NAME}' was not found." >&2
    exit 1
fi

echo "Using interface $(jq -r '.name' <<<"$INTERFACE_OBJECT") at $(jq -r '.ipv4.ipAddress.ipAddress' <<<"$INTERFACE_OBJECT")."

# -----------------------------------------------------------------------------
# 5. Create or update an SNMP host association for each manager
#
# pollEnabled=true allows each manager to query UDP/161.
# trapEnabled=false means the FTD will not send traps to UDP/162.
# Existing associations are matched by their managerAddress object ID.
# -----------------------------------------------------------------------------
HOSTS=$EXISTING_HOSTS

for SNMP_MANAGER_IP in "${SNMP_MANAGER_IPS[@]}"; do
    SAFE_IP=${SNMP_MANAGER_IP//[^a-zA-Z0-9]/-}
    DEFAULT_SNMP_HOST_NAME="${SNMP_HOST_NAME_PREFIX}-${SAFE_IP}"
    NETWORK_OBJECT=${NETWORK_OBJECTS["$SNMP_MANAGER_IP"]}
    NETWORK_ID=$(jq -er '.id' <<<"$NETWORK_OBJECT")

    SNMP_HOST_OBJECT=$(jq -c --arg managerId "$NETWORK_ID" \
        'first(.items[] | select(.managerAddress.id == $managerId)) // empty' \
        <<<"$HOSTS")

    if [[ -n "$SNMP_HOST_OBJECT" ]]; then
        SNMP_HOST_ID=$(jq -er '.id' <<<"$SNMP_HOST_OBJECT")
        SNMP_HOST_VERSION=$(jq -er '.version' <<<"$SNMP_HOST_OBJECT")
        SNMP_HOST_NAME=$(jq -er '.name' <<<"$SNMP_HOST_OBJECT")
    else
        SNMP_HOST_ID=""
        SNMP_HOST_VERSION=""
        SNMP_HOST_NAME="$DEFAULT_SNMP_HOST_NAME"
    fi

    SNMP_HOST_PAYLOAD=$(jq -n \
        --arg version "$SNMP_HOST_VERSION" \
        --arg name "$SNMP_HOST_NAME" \
        --arg managerIp "$SNMP_MANAGER_IP" \
        --arg id "$SNMP_HOST_ID" \
        --argjson manager "$NETWORK_OBJECT" \
        --argjson user "$SNMP_USER_OBJECT" \
        --argjson interface "$INTERFACE_OBJECT" \
        '{
            version: (if $version == "" then null else $version end),
            name: $name,
            description: ("SNMPv3 manager at " + $managerIp),
            managerAddress: {
                version: $manager.version,
                name: $manager.name,
                id: $manager.id,
                type: $manager.type
            },
            udpPort: 162,
            pollEnabled: true,
            trapEnabled: false,
            securityConfiguration: {
                authentication: {
                    version: $user.version,
                    name: $user.name,
                    id: $user.id,
                    type: $user.type
                },
                type: "snmpv3securityconfiguration"
            },
            interface: {
                version: $interface.version,
                name: $interface.name,
                id: $interface.id,
                type: $interface.type
            },
            id: (if $id == "" then null else $id end),
            type: "snmphost"
        }')

    if [[ -n "$SNMP_HOST_ID" ]]; then
        api "/object/snmphosts/${SNMP_HOST_ID}" \
            -X PUT --data-binary "$SNMP_HOST_PAYLOAD" >/dev/null
        SNMP_HOST_OBJECT=$(api "/object/snmphosts/${SNMP_HOST_ID}")
        echo "Updated SNMP host association ${SNMP_HOST_NAME} for ${SNMP_MANAGER_IP}."
    else
        SNMP_HOST_OBJECT=$(api '/object/snmphosts' \
            -X POST --data-binary "$SNMP_HOST_PAYLOAD")
        SNMP_HOST_ID=$(jq -er '.id' <<<"$SNMP_HOST_OBJECT")
        SNMP_HOST_OBJECT=$(api "/object/snmphosts/${SNMP_HOST_ID}")
        echo "Created SNMP host association ${SNMP_HOST_NAME} for ${SNMP_MANAGER_IP}."
    fi

    jq '{name, udpPort, pollEnabled, trapEnabled, managerAddress, securityConfiguration, interface, version, id}' \
        <<<"$SNMP_HOST_OBJECT"
    printf '%s\n' "$SNMP_HOST_OBJECT" >"/tmp/snmp-host-${SAFE_IP}.json"
done

# -----------------------------------------------------------------------------
# 6. Deploy the pending configuration
# -----------------------------------------------------------------------------
DEPLOY=$(api '/operational/deploy' -X POST)
echo "$DEPLOY" | jq .

JOB_ID=$(jq -er '.id' <<<"$DEPLOY")
echo "Deployment job: ${JOB_ID}"

# Poll until deployment finishes. Typical states include QUEUED, DEPLOYING,
# DEPLOYED, and FAILED.
for _ in {1..60}; do
    DEPLOY_STATUS=$(api "/operational/deploy/${JOB_ID}")
    STATE=$(jq -r '.state' <<<"$DEPLOY_STATUS")
    echo "Deployment state: ${STATE}"

    case "$STATE" in
        DEPLOYED)
            break
            ;;
        FAILED|DEPLOYMENT_FAILED)
            jq . <<<"$DEPLOY_STATUS" >&2
            exit 1
            ;;
    esac

    sleep 5
done

if [[ "$STATE" != "DEPLOYED" ]]; then
    echo "ERROR: Deployment did not finish within five minutes." >&2
    exit 1
fi

echo "SNMPv3 configuration deployed successfully."

# -----------------------------------------------------------------------------
# 7. Test from an authorized SNMP manager
#
# The test originates from the computer running this script. It succeeds only
# if that computer's actual source address is included in SNMP_MANAGER_IPS.
# Run the same command separately from each authorized manager as needed.
# -----------------------------------------------------------------------------
printf 'Authorized SNMP manager addresses:\n'
printf '  %s\n' "${SNMP_MANAGER_IPS[@]}"

if command -v snmpwalk >/dev/null; then
    echo "Testing SNMPv3 polling of ${FDM_URL#https://} from this computer ..."
    snmpwalk -v3 -l authPriv \
        -u "$SNMP_USERNAME" \
        -a "$SNMP_AUTH_ALGORITHM" -A "$SNMP_AUTH_PASSWORD" \
        -x AES -X "$SNMP_PRIV_PASSWORD" \
        -t 2 -r 1 \
        "${FDM_URL#https://}" \
        1.3.6.1.2.1.1
else
    cat <<EOF
snmpwalk is not installed. Run this command from each authorized manager:

snmpwalk -v3 -l authPriv -u '${SNMP_USERNAME}' \\
  -a ${SNMP_AUTH_ALGORITHM} -A '${SNMP_AUTH_PASSWORD}' \\
  -x AES -X '${SNMP_PRIV_PASSWORD}' \\
  ${FDM_URL#https://} 1.3.6.1.2.1.1
EOF
fi

